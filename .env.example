# Supabase — URL y clave anónima del proyecto (panel Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API — usada server-side en app/api/parse-voice (Fase 2). Nunca exponer al cliente.
ANTHROPIC_API_KEY=

# Solo para uso local con la Supabase CLI (link/db push/gen types). Nunca se lee en runtime de la app.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
